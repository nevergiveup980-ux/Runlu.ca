{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E100 Model Family Redundancy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "specification_root",
    "variant_relation",
    "verdict",
    "scope",
    "schema_version"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "specification_root": {
      "type": "string",
      "minLength": 1
    },
    "variant_relation": {
      "type": "string",
      "enum": [
        "BASE",
        "PARAMETER_SWEEP",
        "REPARAMETERIZED",
        "NESTED",
        "SIBLING_IMPLEMENTATION"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "DEPENDENT",
        "SEPARATE"
      ]
    },
    "scope": {
      "const": "SYNTHETIC"
    },
    "schema_version": {
      "const": "e100-v1"
    }
  }
}