{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E061 Vocabulary Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vocabulary_version",
    "model_features",
    "preregistered",
    "schema_version"
  ],
  "properties": {
    "vocabulary_version": {
      "type": "string",
      "minLength": 1
    },
    "model_features": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preregistered": {
      "const": true
    },
    "schema_version": {
      "const": "e061-v1"
    }
  }
}