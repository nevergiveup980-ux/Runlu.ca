{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E058 Admission Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "model_set_version",
    "gates",
    "final_status",
    "record_version",
    "schema_version"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_set_version": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "status",
          "rationale"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNRESOLVED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "resolution_evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "final_status": {
      "type": "string",
      "enum": [
        "ADMITTED",
        "EXCLUDED",
        "UNRESOLVED"
      ]
    },
    "record_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "e058-v1"
    }
  }
}