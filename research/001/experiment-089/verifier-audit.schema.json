{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E089 Verifier Version Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "artifact_digest",
    "verifier_id",
    "verifier_version",
    "ruleset_version",
    "observed_output",
    "status",
    "scope",
    "schema_version"
  ],
  "properties": {
    "verification_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_digest": {
      "type": "string",
      "minLength": 1
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    },
    "ruleset_version": {
      "type": "string",
      "minLength": 1
    },
    "observed_output": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "CURRENT_VERIFIER",
        "VERIFIER_OBSOLETE",
        "RULESET_CHANGED",
        "UNREPRODUCIBLE_VERIFICATION"
      ]
    },
    "scope": {
      "const": "SYNTHETIC"
    },
    "schema_version": {
      "const": "e089-v1"
    }
  }
}