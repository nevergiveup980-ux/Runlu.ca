{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E064 Claim Lint Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "declared_scope",
    "text",
    "status",
    "hits",
    "linter_version",
    "schema_version"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "declared_scope": {
      "type": "string",
      "enum": [
        "ANALYTIC",
        "SYNTHETIC",
        "OBSERVATIONAL",
        "OPERATIONAL",
        "PRODUCTION_SAFETY"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "NO_SCOPE_OVERREACH_DETECTED",
        "REVIEW_REQUIRED"
      ]
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linter_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "e064-v1"
    }
  }
}