{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E060 Dependency Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "action",
    "assumptions",
    "vocabulary_version",
    "model_set_version",
    "schema_version"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "TIE"
      ]
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vocabulary_version": {
      "type": "string",
      "minLength": 1
    },
    "model_set_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "e060-v1"
    }
  }
}