    "channel",
    "depth",
    "failure_mode",
    "timescale",
    "operating_regime",
    "scope",
    "schema_version"
  ],
  "properties": {
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "failure_mode": {
      "type": "string",
      "minLength": 1
    },
    "timescale": {
      "type": "string",
      "minLength": 1
    },
    "operating_regime": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "SYNTHETIC"
    },
    "schema_version": {
      "const": "e106-v1"
    }
  }
}