{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E063 Claim Scope Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "scope",
    "evidence_edges",
    "graph_version",
    "schema_version"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "ANALYTIC",
        "SYNTHETIC",
        "OBSERVATIONAL",
        "OPERATIONAL",
        "PRODUCTION_SAFETY"
      ]
    },
    "evidence_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "status",
          "missing"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNRESOLVED"
            ]
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "graph_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "e063-v1"
    }
  }
}