{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E057 Model Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_set_version",
    "models",
    "objective_version",
    "schema_version"
  ],
  "properties": {
    "model_set_version": {
      "type": "string",
      "minLength": 1
    },
    "objective_version": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "status",
          "admission_record_version"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ADMITTED",
              "EXCLUDED",
              "UNRESOLVED"
            ]
          },
          "admission_record_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schema_version": {
      "const": "e057-v1"
    }
  }
}