{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E097 Failure-Mode Dependency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "failure_mode",
    "relevant_layers",
    "source_a",
    "source_b",
    "status",
    "scope",
    "schema_version"
  ],
  "properties": {
    "failure_mode": {
      "type": "string",
      "minLength": 1
    },
    "relevant_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "CALIBRATION",
          "SOFTWARE",
          "LABEL_SOURCE"
        ]
      }
    },
    "source_a": {
      "type": "string",
      "minLength": 1
    },
    "source_b": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "FAILURE_MODE_DEPENDENT",
        "NO_RELEVANT_DECLARED_PATH",
        "MODEL_UNRESOLVED"
      ]
    },
    "scope": {
      "const": "SYNTHETIC"
    },
    "schema_version": {
      "const": "e097-v1"
    }
  }
}