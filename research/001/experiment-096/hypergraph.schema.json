{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E096 Multi-Layer Dependency Hypergraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observer_id",
    "critical_roots",
    "scope",
    "schema_version"
  ],
  "properties": {
    "observer_id": {
      "type": "string",
      "minLength": 1
    },
    "critical_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layer",
          "root_id"
        ],
        "properties": {
          "layer": {
            "type": "string",
            "enum": [
              "CALIBRATION",
              "SOFTWARE",
              "LABEL_SOURCE"
            ]
          },
          "root_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope": {
      "const": "SYNTHETIC"
    },
    "schema_version": {
      "const": "e096-v1"
    }
  }
}