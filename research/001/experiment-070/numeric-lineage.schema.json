{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUNLU Research 001B E070 Numeric Lineage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "numeric_claim_id",
    "sources",
    "transform",
    "displayed_value",
    "tolerance",
    "status",
    "schema_version"
  ],
  "properties": {
    "numeric_claim_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "version"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "transform": {
      "type": "string",
      "enum": [
        "IDENTITY",
        "PERCENT",
        "ROUND",
        "DIFFERENCE",
        "RATIO",
        "NORMALIZE"
      ]
    },
    "displayed_value": {
      "type": "number"
    },
    "tolerance": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS_NUMERIC_LINEAGE",
        "NUMERIC_REVIEW"
      ]
    },
    "schema_version": {
      "const": "e070-v1"
    }
  }
}