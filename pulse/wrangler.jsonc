{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runlu-pulse",
  "main": "src/index-calgary.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "pulse.runlu.ca",
      "custom_domain": true
    }
  ],
  "vars": {
    "RUNLU_HOST": "runlu.ca",
    "RUNLU_HOME_COUNTRY": "CA",
    "RUNLU_TIME_ZONE": "America/Edmonton"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": [
      "CF_ANALYTICS_TOKEN",
      "CF_ACCOUNT_ID"
    ]
  }
}
